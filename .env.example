# Copiez ce fichier en `.env` et renseignez vos valeurs.

# Token du bot Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=votre_token_ici

# (Optionnel) Tableau de bord « live » des stats joueurs.
# ID du salon où poster/éditer le message (clic droit sur le salon > Copier l'identifiant).
STATS_CHANNEL_ID=
# Liste des pseudos suivis, séparés par des virgules.
STATS_PLAYERS=MasteRX_,Nasara__,Finkeleb,Ayzziixx,Doriko79,Nathan201204

# (Optionnel) Guilde suivie (statut du bot + dashboard).
# Doit être le nom EXACT tel que connu de l'API (ou l'UUID de la guilde).
GUILD_PRESENCE=S7ven
# (Optionnel) Salon où poster/éditer le dashboard de la guilde ci-dessus.
GUILD_CHANNEL_ID=
